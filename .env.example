# System Configuration for vi-coze RAG

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Indexing accelerator
INDEX_DEVICE=auto
INDEX_DTYPE=auto
INDEX_BATCH_SIZE=8
CHROMA_BATCH_SIZE=128

# Intel Arc A370M 4GB example:
# INDEX_DEVICE=xpu:0
# INDEX_DTYPE=float16
# INDEX_BATCH_SIZE=8

RETRIEVAL_TOP_K=15
RERANK_TOP_N=5
RERANK_THRESHOLD=0.35

MAX_CONTEXT_TOKENS=4000

# LLM Provider Options: gemini | openai | ollama | mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1200

# API Keys (Set your key here)
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
